# Base de données
# - Local sans Docker (défaut) : SQLite
#     DATABASE_URL=file:./parcbeauregard.db
# - Local avec Docker (docker compose up -d) :
#     DATABASE_URL=postgres://payload:payload@localhost:5432/parcbeauregard
# - Vercel preview : chaîne Neon / Vercel Postgres
# - VPS prod : Postgres du serveur
DATABASE_URL=file:./parcbeauregard.db

# Clé secrète Payload (générer une valeur aléatoire longue, unique par environnement)
PAYLOAD_SECRET=changez-moi
